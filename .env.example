# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# --- Test email (CAN-REQ-009). Leave CANARY_SMTP_HOST empty to keep sends "Blocked".
CANARY_SMTP_HOST=
CANARY_SMTP_PORT=587
CANARY_SMTP_STARTTLS=1
CANARY_SMTP_SSL=0
CANARY_SMTP_USERNAME=
CANARY_SMTP_PASSWORD=
CANARY_MAIL_FROM=
# Only these team-owned addresses can ever receive mail (comma-separated).
CANARY_EMAIL_ALLOWLIST=
# Optional: pre-map fictional demo people to team-owned test addresses at seed/reset time.
# CANARY_TEST_RECIPIENTS=sureh=you+sureh@yourteam.example,wyatt=you+wyatt@yourteam.example

# --- Optional live source (public RSS of The Hacker News, AI-related items only)
CANARY_LIVE_SOURCES=0

# --- Other
# CANARY_SECRET_KEY=change-me-for-stable-sessions
# CANARY_FIXED_NOW=2026-11-14T15:00:00+00:00
# CANARY_SCHEDULER=1
