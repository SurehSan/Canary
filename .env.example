# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# --- Test email (CAN-REQ-009). Leave CANARY_SMTP_HOST empty to keep sends "Blocked".
# Tested route: Gmail. CANARY_SMTP_HOST=smtp.gmail.com, port 587, STARTTLS=1, username and
# MAIL_FROM = the Gmail address, password = a Gmail App Password (not the account password).
# University Microsoft 365 accounts fail with 535 5.7.139 (SMTP AUTH disabled for the tenant).
# Keep each setting on ONE line: the first occurrence wins, and text after the value is NOT
# treated as a comment.
CANARY_SMTP_HOST=
CANARY_SMTP_PORT=587
CANARY_SMTP_STARTTLS=1
CANARY_SMTP_SSL=0
CANARY_SMTP_USERNAME=
CANARY_SMTP_PASSWORD=
CANARY_MAIL_FROM=
# Team-owned addresses that can always receive mail (comma-separated).
CANARY_EMAIL_ALLOWLIST=
# Domains Administrators may add addresses on in Notifications -> Allowlist (comma-separated, e.g. gmail.com).
# Leave empty to allow only the domains used in CANARY_EMAIL_ALLOWLIST.
CANARY_ALLOWLIST_DOMAINS=
# Optional: pre-map fictional demo people to team-owned test addresses at seed/reset time.
# CANARY_TEST_RECIPIENTS=sureh=you+sureh@yourteam.example,wyatt=you+wyatt@yourteam.example

# --- Optional live source (public RSS of The Hacker News, AI-related items only)
CANARY_LIVE_SOURCES=0

# --- Other
# CANARY_SECRET_KEY=change-me-for-stable-sessions
# CANARY_FIXED_NOW=2026-11-14T15:00:00+00:00
# CANARY_SCHEDULER=1
